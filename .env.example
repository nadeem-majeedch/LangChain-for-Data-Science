# =============================================================================
# LangChain for Data Science — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#
#   cp .env.example .env
#
# NEVER commit .env to version control. It is already listed in .gitignore.
# =============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# (Optional) OpenAI Organization ID — only needed if you belong to multiple orgs
# OPENAI_ORG_ID=

# (Optional) Ollama base URL — default is http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# (Optional) Default model names — uncomment to override notebook defaults
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=llama3.2
